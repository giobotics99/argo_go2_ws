<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_patrol_mission</name>
  <version>0.0.1</version>
  <description>PlanSys2 patrol mission for Unitree Go2</description>
  <maintainer email="giovanna@todo.com">giovanna</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclpy</depend>
  <depend>plansys2_msgs</depend>
  <depend>plansys2_executor</depend>
  <depend>plansys2_domain_expert</depend>
  <depend>plansys2_problem_expert</depend>
  <depend>plansys2_planner</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>go2_interfaces</depend>
  <depend>unitree_go</depend>
  <depend>yaml-cpp</depend>
  <depend>std_msgs</depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
